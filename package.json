{
  "name": "gym-ai-coach-backend",
  "version": "1.0.0",
  "description": "Backend API for GYM AI Coach application",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "cross-env NODE_ENV=development nodemon server.js",
    "debug": "cross-env NODE_ENV=development nodemon --inspect server.js",
    "test": "cross-env NODE_ENV=test jest -c tests/setup/jest.config.js --runInBand",
    "test:watch": "cross-env NODE_ENV=test jest -c tests/setup/jest.config.js --watch",
    "test:coverage": "cross-env NODE_ENV=test jest -c tests/setup/jest.config.js --coverage",
    "test:unit": "cross-env NODE_ENV=test jest -c tests/setup/jest.config.js --selectProjects unit",
    "test:integration": "cross-env NODE_ENV=test jest -c tests/setup/jest.config.js --selectProjects integration",
    "test:ci": "cross-env NODE_ENV=test jest -c tests/setup/jest.config.js --coverage --runInBand --watchAll=false",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "test:migrate": "dotenv -e .env.test -- prisma migrate deploy"
  },
  "keywords": [
    "nodejs",
    "express",
    "jwt",
    "prisma",
    "postgresql"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "joi": "^17.13.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "ms": "^2.1.3",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.4.1",
    "@types/jest": "^29.5.12",
    "cross-env": "^7.0.3",
    "dotenv-cli": "^7.4.2",
    "jest": "^29.7.0",
    "jest-extended": "^4.0.2",
    "nodemon": "^3.1.0",
    "prisma": "^5.14.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "setupFilesAfterEnv": ["jest-extended/all"]
  }
}
