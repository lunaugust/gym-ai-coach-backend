{
  "name": "gym-ai-coach-backend",
  "version": "1.0.0",
  "description": "Backend API for GYM AI Coach application",
  "main": "server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "cross-env NODE_ENV=development ts-node-dev --respawn --transpile-only server.ts",
    "debug": "cross-env NODE_ENV=development ts-node-dev --inspect --respawn --transpile-only server.ts",
    "test": "cross-env NODE_ENV=test jest -c tests/setup/jest.config.js --runInBand",
    "test:watch": "cross-env NODE_ENV=test jest -c tests/setup/jest.config.js --watch",
    "test:coverage": "cross-env NODE_ENV=test jest -c tests/setup/jest.config.js --coverage",
    "test:unit": "cross-env NODE_ENV=test jest -c tests/setup/jest.config.js --selectProjects unit",
    "test:integration": "cross-env NODE_ENV=test jest -c tests/setup/jest.config.js --selectProjects integration --runInBand",
    "test:ci": "cross-env NODE_ENV=test jest -c tests/setup/jest.config.js --coverage --runInBand --watchAll=false",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "test:migrate": "dotenv -e .env.test -- prisma migrate deploy"
  },
  "keywords": [
    "nodejs",
    "express",
    "jwt",
    "prisma",
    "postgresql"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "joi": "^17.13.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "ms": "^2.1.3",
    "multer": "^2.0.2",
    "sharp": "^0.34.3",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.4.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/joi": "^17.2.2",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/ms": "^0.7.34",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.7.5",
    "cross-env": "^7.0.3",
    "dotenv-cli": "^7.4.2",
    "jest": "^29.7.0",
    "jest-extended": "^4.0.2",
    "nodemon": "^3.1.0",
    "prisma": "^5.14.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3"
  },
  "jest": {
    "setupFilesAfterEnv": [
      "jest-extended/all"
    ]
  }
}
