{
  "info": {
    "_postman_id": "gym-ai-coach-collection-001",
    "name": "GYM AI Coach API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Postman collection for GYM AI Coach Backend API."
  },
  "item": [
    {
      "name": "Get User Profile",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt_token}}", "type": "text" }
        ],
        "url": { "raw": "{{base_url}}/api/users/profile", "host": ["{{base_url}}"], "path": ["api", "users", "profile"] }
      }
    },
    {
      "name": "Update User Profile",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt_token}}", "type": "text" },
          { "key": "Content-Type", "value": "application/json", "type": "text" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Jane Doe\",\n  \"bio\": \"Loves yoga and running.\",\n  \"age\": 28,\n  \"gender\": \"female\",\n  \"location\": \"San Francisco, CA\",\n  \"timezone\": \"America/Los_Angeles\"\n}"
        },
        "url": { "raw": "{{base_url}}/api/users/profile", "host": ["{{base_url}}"], "path": ["api", "users", "profile"] }
      }
    },
    {
      "name": "Get Preferences",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt_token}}", "type": "text" }
        ],
        "url": { "raw": "{{base_url}}/api/users/preferences", "host": ["{{base_url}}"], "path": ["api", "users", "preferences"] }
      }
    },
    {
      "name": "Update Preferences",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt_token}}", "type": "text" },
          { "key": "Content-Type", "value": "application/json", "type": "text" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"preferredWorkoutDays\": [\"tuesday\", \"thursday\"],\n  \"units\": \"imperial\"\n}"
        },
        "url": { "raw": "{{base_url}}/api/users/preferences", "host": ["{{base_url}}"], "path": ["api", "users", "preferences"] }
      }
    },
    {
      "name": "Get Measurements",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt_token}}", "type": "text" }
        ],
        "url": { "raw": "{{base_url}}/api/users/measurements", "host": ["{{base_url}}"], "path": ["api", "users", "measurements"] }
      }
    },
    {
      "name": "Add Measurement",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt_token}}", "type": "text" },
          { "key": "Content-Type", "value": "application/json", "type": "text" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"weight\": 80,\n  \"height\": 180,\n  \"bmi\": 24.7\n}"
        },
        "url": { "raw": "{{base_url}}/api/users/measurements", "host": ["{{base_url}}"], "path": ["api", "users", "measurements"] }
      }
    },
    {
      "name": "Update Measurement",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt_token}}", "type": "text" },
          { "key": "Content-Type", "value": "application/json", "type": "text" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"weight\": 82\n}"
        },
        "url": { "raw": "{{base_url}}/api/users/measurements/:id", "host": ["{{base_url}}"], "path": ["api", "users", "measurements", ":id"] }
      }
    },
    {
      "name": "Delete Measurement",
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt_token}}", "type": "text" }
        ],
        "url": { "raw": "{{base_url}}/api/users/measurements/:id", "host": ["{{base_url}}"], "path": ["api", "users", "measurements", ":id"] }
      }
    },
    {
      "name": "Get Progress",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt_token}}", "type": "text" }
        ],
        "url": { "raw": "{{base_url}}/api/users/measurements/progress", "host": ["{{base_url}}"], "path": ["api", "users", "measurements", "progress"] }
      }
    }
  ],
  "variable": [
    { "key": "base_url", "value": "http://localhost:3000" },
    { "key": "jwt_token", "value": "<your-jwt-token>" }
  ]
}